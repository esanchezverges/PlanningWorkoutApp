@namespace PlanningWorkoutApp.Web

<RadzenCard>
    <label> (PlaceholderImageThumnail) @Value.Name (this is a dropdown to change exercise) </label>
    @foreach ( IWorkoutSet set in Value.Sets )
    {
        <div class="rz-display-flex gap-4 align-items-center">
            <label>@set.SetNumber</label>
            <PlanInput Label="Repeticiones" />
            <PlanInput Label="Peso (kg)" />
            <div class="rz-display-flex gap-1 align-items-center">
                <RadzenButton Icon="delete" Click=@(_ => DeleteSet(set)) />
                <RadzenButton Visible="@(set.SetNumber > 1)" Icon="arrow_upward" Click=@(_ => ReorderUpwards(set)) />
                <RadzenButton Visible="@(set.SetNumber < Value.Sets.Count)" Icon="arrow_downward" Click=@(_ => ReorderDownwards(set)) />
            </div>
        </div>
    }
    <RadzenButton Click="AddSet" Text="Añadir set" />
    <RadzenButton Click="OnDeleteExerciseHandler" ButtonStyle="ButtonStyle.Danger" Text="Eliminar"></RadzenButton>
</RadzenCard>

@code {
    [Parameter] public EventCallback<ExerciseInWorkout<IWorkoutSet>> OnDeleteExercise { get; set; }
    [Parameter] public ExerciseInWorkout<IWorkoutSet> Value { get; set; } = null!;
    [Parameter] public EventCallback<ExerciseInWorkout<IWorkoutSet>> ValueChanged { get; set; }

    protected override void OnInitialized()
    {
        if (Value is null)
            throw new ArgumentNullException("Value is null in FrmExercise",nameof(Value));
    }

    private void DeleteSet(IWorkoutSet set)
    {
        var index = set.SetNumber -1;
        Value.Sets.RemoveAt(index);
        ReenumerateSets();
    }

    private void ReorderUpwards(IWorkoutSet set)
    {
        var index = set.SetNumber -1;
	    Value.Sets.RemoveAt(index);
	    Value.Sets.Insert(index - 1, set);
	    ReenumerateSets();
    }

    private void ReorderDownwards(IWorkoutSet set)
    {
        var index = set.SetNumber -1;
	    Value.Sets.RemoveAt(index);
	    Value.Sets.Insert(index + 1, set);
	    ReenumerateSets();
    }

    private void ReenumerateSets()
    {
        for (int i = 0; i < Value.Sets.Count; i++)
        {
            Value.Sets[i].SetNumber = i + 1;
        }
    }

    private void AddSet()
    {
        Value.Sets.Add(new WeightedSet(Value.Sets.Count + 1, TimeSpan.FromSeconds(20), 0, 0));
    }

    private async void OnValueChangedHandler()
    {

    }

    private async void OnDeleteExerciseHandler()
    {
        await OnDeleteExercise.InvokeAsync(Value);
    }

}
